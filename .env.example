# Copy values into your shell or a local .env loader. Do not commit real secrets.

FLASK_SECRET_KEY=replace-with-python-secrets-token-hex-32
FLASK_DEBUG=0
# Local HTTP development: keep COOKIE_SECURE=0.
# HTTPS production: set COOKIE_SECURE=1 so session cookies are Secure-only
# and the app sends Strict-Transport-Security.
COOKIE_SECURE=0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jc_aqua_fish_shop

# Required for staff signup at /register. Staff registration is blocked when unset.
STAFF_REGISTRATION_CODE=replace-with-a-private-invite-code

# SMTP / Gmail App Password (required for customer registration OTP)
# Set SMTP_ENABLED=1 and use a Gmail App Password (not your normal password).
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_SENDER=YOUR_GMAIL_ADDRESS

# Firebase Authentication (customer Google / email sign-in)
# Create a Firebase web app, enable Google + Email/Password providers,
# then download a service account JSON for Admin token verification.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
# Path to service account JSON (preferred), or paste JSON into FIREBASE_CREDENTIALS_JSON
FIREBASE_CREDENTIALS_FILE=
# FIREBASE_CREDENTIALS_JSON=
