# Copy to .env for local development. Do not commit real secrets.
# On Vercel: Project Settings → Environment Variables (paste the same keys).
# IMPORTANT: Vercel cannot use MYSQL_HOST=127.0.0.1 — use a cloud MySQL host.

FLASK_APP=app.py
FLASK_DEBUG=0
FLASK_SECRET_KEY=replace-with-python-secrets-token-hex-32
# Local HTTP: 0. Vercel/HTTPS: 1 (auto-enabled on Vercel if unset).
COOKIE_SECURE=0

# --- MySQL (local XAMPP / Workbench) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jc_aqua_fish_shop
# Local: 0. Cloud MySQL (Railway/Aiven/etc.): 1 or leave unset (auto for non-localhost)
MYSQL_SSL=0

# --- OR one connection URL (cloud) ---
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/jc_aqua_fish_shop

# Required for staff signup at /register
STAFF_REGISTRATION_CODE=replace-with-a-private-invite-code

# SMTP / Gmail App Password (required for customer OTP emails)
SMTP_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_SENDER=YOUR_GMAIL_ADDRESS

# Optional Firebase customer auth
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_FILE=
